generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String?
  displayName       String?
  avatarUrl         String?
  emailVerified     Boolean            @default(false)
  status            UserStatus         @default(ACTIVE)
  tokenVersion      Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  auditLogs         AuditLog[]
  authTokens        AuthToken[]
  connectedAccounts ConnectedAccount[]
  oauthStates       OAuthState[]
  requestLogs       RequestLog[]
  syncJobs          SyncJob[]
  uploadSessions    UploadSession[]

  @@index([email])
}

model Admin {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  displayName  String?
  role         AdminRole    @default(ADMIN)
  tokenVersion Int          @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  auditLogs    AuditLog[]
  requestLogs  RequestLog[]

  @@index([email])
  @@index([role])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
}

model ConnectedAccount {
  id                    String          @id @default(cuid())
  userId                String
  googleEmail           String          @unique
  displayName           String?
  avatarUrl             String?
  accessToken           String
  refreshToken          String
  expiresAt             DateTime
  storageLimit          BigInt          @default(16106127360)
  storageUsed           BigInt          @default(0)
  quotaUpdatedAt        DateTime        @default(now())
  status                AccountStatus   @default(ACTIVE)
  lastSyncAt            DateTime?
  lastSyncError         String?
  reauthRequiredAt      DateTime?
  driveChangesPageToken String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileCache             FileCache[]
  syncJobs              SyncJob[]
  uploadSessions        UploadSession[]

  @@index([userId])
  @@index([expiresAt])
}

model FileCache {
  id              String           @id @default(cuid())
  accountId       String
  driveFileId     String
  name            String
  mimeType        String
  fileType        FileType         @default(OTHER)
  sizeBytes       BigInt           @default(0)
  webViewLink     String?
  thumbnailLink   String?
  thumbnailUpdatedAt DateTime?
  iconLink        String?
  driveParentId   String?
  isFolder        Boolean          @default(false)
  driveCreatedAt  DateTime
  driveModifiedAt DateTime
  cachedAt        DateTime         @default(now())
  account         ConnectedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, driveFileId])
  @@index([accountId])
  @@index([accountId, fileType])
  @@index([accountId, driveModifiedAt(sort: Desc)])
  @@index([name])
}

model UploadSession {
  id            String           @id @default(cuid())
  userId        String
  accountId     String
  sessionUri    String
  fileName      String
  mimeType      String
  fileType      FileType         @default(OTHER)
  fileSize      BigInt
  status        UploadStatus     @default(PENDING)
  bytesUploaded BigInt           @default(0)
  driveFileId   String?
  verifiedAt    DateTime?
  expiresAt     DateTime
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  account       ConnectedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([status])
  @@index([expiresAt])
}

model OAuthState {
  id        String    @id @default(cuid())
  userId    String
  stateHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SyncJob {
  id         String           @id @default(cuid())
  userId     String
  accountId  String
  status     SyncJobStatus    @default(RUNNING)
  error      String?
  startedAt  DateTime         @default(now())
  finishedAt DateTime?
  account    ConnectedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([status])
  @@index([startedAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  adminId    String?
  action     AuditAction
  accountId  String?
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  admin      Admin?      @relation(fields: [adminId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([adminId])
  @@index([action])
  @@index([accountId])
  @@index([createdAt])
}

model RequestLog {
  id         String   @id @default(cuid())
  userId     String?
  adminId    String?
  method     String
  path       String
  statusCode Int
  durationMs Int
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())
  admin      Admin?   @relation(fields: [adminId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([adminId])
  @@index([method])
  @@index([path])
  @@index([statusCode])
  @@index([createdAt])
}

enum UploadStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  EXPIRED
}

enum FileType {
  DOCUMENT
  SPREADSHEET
  PRESENTATION
  PDF
  IMAGE
  VIDEO
  AUDIO
  FOLDER
  OTHER
}

enum AccountStatus {
  ACTIVE
  REAUTH_REQUIRED
  SYNC_FAILED
  DISCONNECTED
}

enum SyncJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum AuditAction {
  ADMIN_LOGIN
  ADMIN_LOGOUT
  USER_DISABLED
  USER_ENABLED
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT
  EMAIL_VERIFICATION_REQUESTED
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  GOOGLE_ACCOUNT_CONNECTED
  GOOGLE_ACCOUNT_REAUTHED
  GOOGLE_ACCOUNT_DISCONNECTED
  GOOGLE_ACCOUNT_REAUTH_REQUIRED
  QUOTA_REFRESHED
  FILE_SYNC_STARTED
  FILE_SYNC_SUCCEEDED
  FILE_SYNC_FAILED
  UPLOAD_SESSION_CREATED
  UPLOAD_COMPLETED
  FILE_DELETED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}
